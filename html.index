<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SC&U 이동 약자 맞춤형 스마트 지도 데모 (V4.4)</title>
    <!-- React & Babel Loaders -->
    <script crossorigin src="https://unpkg.com/react@18/umd/react.development.js"></script>
    <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"></script>
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        .map-transition { transition: background-image 1s ease-in-out, transform 1.5s ease-in-out; }
        .pulse-animation { animation: pulse 1.5s cubic-bezier(0.4, 0, 0.6, 1) infinite; }
        @keyframes pulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.8; transform: scale(1.15); } }
        
        /* 얇고 선명한 초록색 선 */
        .path-line { fill: none; stroke: #22c55e; stroke-width: 3.5; stroke-linecap: round; stroke-linejoin: round; }
        
        /* 주차장 빗금 패턴 */
        .parking-striped { background: repeating-linear-gradient(45deg, #3b82f6, #3b82f6 5px, #ef4444 5px, #ef4444 10px); }
    </style>
</head>
<body class="bg-gray-100 h-screen font-sans">
    <div id="root"></div>

    <script type="text/babel">
        const { useState, useEffect } = React;

        const IMAGES = {
            bgMain: './image_16.png',
            bgZoom: './image_13.png',
            pin: './image_15.png',
            arrow: './image_10.png',
            warning: './image_9.png',
        };

        const App = () => {
            const [phase, setPhase] = useState('INIT');
            
            const [arrow, setArrow] = useState({ left: 5, top: 62, rotate: 85, duration: 0 });
            
            // [수정됨] 초기 offset을 0으로 두어 선이 다 그려진 상태로 시작하고, 마커 이동에 따라 양수(+)로 증가하여 지나온 선이 지워지도록 설정
            const [pathState, setPathState] = useState({
                s1: { offset: 0, dur: 0 }, 
                s2: { offset: 0, dur: 0 }, 
                s3: { offset: 0, dur: 0 }, 
                s4: { offset: 0, dur: 0 }  
            });

            const [mapBg, setMapBg] = useState(IMAGES.bgMain);

            useEffect(() => {
                // [이동 1] 출발 -> 1차 장애물 (로터리)
                if (phase === 'NAV_1') {
                    setArrow({ left: 41, top: 55, rotate: 85, duration: 2.5 });
                    // 양수(+) 값으로 오프셋을 주어 마커가 전진할 때 뒤쪽 선이 지워지도록 함
                    setPathState(p => ({ ...p, s1: { offset: 60, dur: 2.5 } }));
                    
                    const timer = setTimeout(() => setPhase('OBS_1'), 2500);
                    return () => clearTimeout(timer);
                }
                
                // [이동 2] 1차 장애물 무시 -> 2차 장애물 (세븐일레븐 앞)
                if (phase === 'NAV_2') {
                    setArrow({ left: 41, top: 55, rotate: -5, duration: 0.2 });
                    
                    const timer1 = setTimeout(() => {
                        setArrow({ left: 38, top: 40, rotate: -5, duration: 1.5 });
                        setPathState(p => ({ ...p, s2: { offset: 40, dur: 1.5 } }));
                    }, 200);
                    
                    const timer2 = setTimeout(() => setPhase('OBS_2'), 1700);
                    return () => { clearTimeout(timer1); clearTimeout(timer2); };
                }
                
                // [이동 3] 2차 장애물 무시 -> E6 도착
                if (phase === 'NAV_END') {
                    setArrow({ left: 37, top: 30, rotate: -5, duration: 1.0 }); 
                    setPathState(p => ({ ...p, s2: { offset: 70, dur: 1.0 } }));
                    
                    const timer1 = setTimeout(() => {
                        setArrow({ left: 37, top: 30, rotate: 85, duration: 0.2 }); 
                    }, 1000);
                    
                    const timer2 = setTimeout(() => {
                        setArrow({ left: 48, top: 28, rotate: 85, duration: 1.0 }); 
                        setPathState(p => ({ ...p, s3: { offset: 50, dur: 1.0 } }));
                    }, 1200);
                    
                    const timer3 = setTimeout(() => {
                        setArrow({ left: 48, top: 28, rotate: 15, duration: 0.2 }); 
                    }, 2200);
                    
                    const timer4 = setTimeout(() => {
                        setArrow({ left: 52, top: 18, rotate: 15, duration: 0.8 }); 
                        setPathState(p => ({ ...p, s4: { offset: 50, dur: 0.8 } }));
                    }, 2400);
                    
                    const timer5 = setTimeout(() => setPhase('ARRIVED_PROMPT'), 3200);
                    return () => { clearTimeout(timer1); clearTimeout(timer2); clearTimeout(timer3); clearTimeout(timer4); clearTimeout(timer5); };
                }
                
                if (phase === 'ARRIVED') {
                    setMapBg(IMAGES.bgZoom);
                }
            }, [phase]);

            const renderStatusCard = () => {
                const statuses = {
                    'INIT': { title: '대기 중', desc: '목적지를 설정하고 안내를 시작하세요.' },
                    'DEST_CONFIRM': { title: '3-1. 이동 시작', desc: 'E6 건물로 안내를 준비합니다.' },
                    'LOC_AUTH': { title: '3-1. 이동 시작', desc: '경로 탐색이 완료되었습니다.' },
                    'NAV_1': { title: '이동 중...', desc: '목적지로 이동하고 있습니다.' },
                    'OBS_1': { title: '3-2. 1차 장애물 감지', desc: '전방에 장애물이 제보되었습니다.' },
                    'NAV_2': { title: '기존 경로 유지', desc: '장애물 경고를 무시하고 기존 경로로 이동합니다.' },
                    'OBS_2': { title: '3-2. 2차 장애물 감지', desc: '전방에 도로 정비 공사가 진행 중입니다.' },
                    'NAV_END': { title: '목적지 접근 중', desc: 'E6 건물에 거의 도착했습니다.' },
                    'ARRIVED_PROMPT': { title: '목적지 도달', desc: '목적지 부근에 도착했습니다.' },
                    'ARRIVED': { title: '3-3. 도착 및 주차', desc: '주차장 탐색을 시작합니다.' },
                    'PARKING_SEARCH': { title: '주차장 안내', desc: '지정된 주차 구역의 상태를 확인하세요.' },
                    'DONE': { title: '이용 종료', desc: '주차가 완료되었습니다.' },
                };
                const currentStatus = statuses[phase] || statuses['INIT'];

                return (
                    <div className="bg-white p-6 rounded-xl shadow-lg h-full border-t-4 border-green-500">
                        <h2 className="text-xl font-bold text-gray-800 mb-2">상태 보드</h2>
                        <div className="p-4 bg-green-50 rounded-lg border border-green-100">
                            <h3 className="font-bold text-green-800 text-lg">{currentStatus.title}</h3>
                            <p className="text-gray-600 mt-2 text-sm leading-relaxed">{currentStatus.desc}</p>
                        </div>
                    </div>
                );
            };

            const renderControlPanel = () => {
                return (
                    <div className="bg-white p-6 rounded-xl shadow-lg h-full flex flex-col">
                        <h2 className="text-xl font-bold text-gray-800 mb-4">제어 패널</h2>
                        <div className="flex-1 flex flex-col gap-3 justify-center">
                            
                            {phase === 'INIT' && (
                                <div className="text-center">
                                    <p className="mb-4 font-semibold text-gray-700">E6 건물로 이동하시겠습니까?</p>
                                    <button onClick={() => setPhase('DEST_CONFIRM')} className="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg font-bold w-full">예</button>
                                </div>
                            )}

                            {phase === 'DEST_CONFIRM' && (
                                <button onClick={() => setPhase('LOC_AUTH')} className="bg-green-500 text-white px-4 py-3 rounded-lg font-bold w-full">📍 위치 권한 허용</button>
                            )}

                            {phase === 'LOC_AUTH' && (
                                <button onClick={() => setPhase('NAV_1')} className="bg-blue-600 text-white px-4 py-3 rounded-lg font-bold w-full animate-pulse">🚗 경로 안내 시작</button>
                            )}

                            {phase === 'OBS_1' && (
                                <div className="bg-red-50 border border-red-200 p-4 rounded-lg flex flex-col gap-2">
                                    <p className="text-red-600 font-bold mb-1">🚨 1차 장애물 (전방 장애물)</p>
                                    <button className="bg-gray-300 text-gray-500 px-4 py-2 rounded-lg font-bold cursor-not-allowed text-sm">대체 경로 우회</button>
                                    <button onClick={() => setPhase('NAV_2')} className="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg font-bold shadow-md transition-all text-sm">✅ 기존 경로 유지하기</button>
                                </div>
                            )}

                            {phase === 'OBS_2' && (
                                <div className="bg-red-50 border border-red-200 p-4 rounded-lg flex flex-col gap-2">
                                    <p className="text-red-600 font-bold mb-1">🚧 2차 장애물 (도로 정비)</p>
                                    <button className="bg-gray-300 text-gray-500 px-4 py-2 rounded-lg font-bold cursor-not-allowed text-sm">대체 경로 우회</button>
                                    <button onClick={() => setPhase('NAV_END')} className="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg font-bold shadow-md transition-all text-sm">✅ 기존 경로 유지하기</button>
                                </div>
                            )}

                            {phase === 'ARRIVED_PROMPT' && (
                                <button onClick={() => setPhase('ARRIVED')} className="bg-blue-600 text-white px-4 py-3 rounded-lg font-bold w-full">🏁 목적지 도착 확인</button>
                            )}

                            {phase === 'ARRIVED' && (
                                <button onClick={() => setPhase('PARKING_SEARCH')} className="bg-blue-600 text-white px-4 py-3 rounded-lg font-bold w-full">🅿️ 주변 주차장 안내 켜기</button>
                            )}

                            {phase === 'PARKING_SEARCH' && (
                                <div className="bg-blue-50 border border-blue-200 p-4 rounded-lg">
                                    <p className="text-blue-800 text-sm mb-3 font-semibold">지도에서 3개의 주차 칸 상태를 확인하세요. <br/>(가장 좌측 자리 선택 가능)</p>
                                    <button onClick={() => setPhase('DONE')} className="bg-green-500 hover:bg-green-600 text-white px-4 py-2 rounded-lg font-bold w-full">빈 주차자리에 주차 완료</button>
                                </div>
                            )}

                            {phase === 'DONE' && (
                                <div className="text-center p-4">
                                    <span className="text-4xl">🎉</span>
                                    <p className="font-bold text-gray-800 mt-2 text-lg">주차가 완료되었습니다.</p>
                                    <button onClick={() => window.location.reload()} className="mt-4 text-gray-500 underline text-sm">데모 다시하기</button>
                                </div>
                            )}
                        </div>
                    </div>
                );
            };

            return (
                <div className="flex h-screen p-4 gap-4 max-w-[1400px] mx-auto min-w-[900px]">
                    <div className="w-1/4 min-w-[280px]">
                        {renderStatusCard()}
                    </div>

                    <div className="flex-1 bg-gray-200 rounded-xl shadow-lg relative overflow-hidden border-2 border-gray-300">
                        {/* 지도 배경 */}
                        <div className="absolute inset-0 map-transition"
                             style={{
                                 backgroundImage: `url(${mapBg})`,
                                 backgroundSize: 'cover',
                                 backgroundPosition: 'center',
                             }}>
                        </div>

                        {/* 지도 위 오버레이 */}
                        <div className="absolute inset-0">
                            
                            {/* [수정됨] 마커 전진에 맞춰 선이 자연스럽게 뒤에서부터 지워짐 */}
                            {phase !== 'INIT' && phase !== 'ARRIVED' && phase !== 'PARKING_SEARCH' && phase !== 'DONE' && (
                                <svg viewBox="0 0 100 100" className="w-full h-full absolute top-0 left-0 drop-shadow-md preserve-3d" preserveAspectRatio="none">
                                    <path d="M 5 62 L 41 55" className="path-line" strokeDasharray="100" strokeDashoffset={pathState.s1.offset} style={{ transition: `stroke-dashoffset ${pathState.s1.dur}s linear` }} />
                                    <path d="M 41 55 L 37 30" className="path-line" strokeDasharray="100" strokeDashoffset={pathState.s2.offset} style={{ transition: `stroke-dashoffset ${pathState.s2.dur}s linear` }} />
                                    <path d="M 37 30 L 48 28" className="path-line" strokeDasharray="100" strokeDashoffset={pathState.s3.offset} style={{ transition: `stroke-dashoffset ${pathState.s3.dur}s linear` }} />
                                    <path d="M 48 28 L 52 18" className="path-line" strokeDasharray="100" strokeDashoffset={pathState.s4.offset} style={{ transition: `stroke-dashoffset ${pathState.s4.dur}s linear` }} />
                                </svg>
                            )}

                            {/* 목적지 핀 */}
                            {phase !== 'INIT' && (
                                <img src={IMAGES.pin} alt="목적지" 
                                     className={`absolute w-12 h-12 transform -translate-x-1/2 -translate-y-full drop-shadow-xl transition-all duration-1000 ${phase === 'ARRIVED' || phase === 'PARKING_SEARCH' || phase === 'DONE' ? 'top-[40%] left-[55%] scale-[1.2]' : 'top-[18%] left-[52%]'}`} 
                                />
                            )}

                            {/* 1차 장애물 팝업 */}
                            {phase === 'OBS_1' && (
                                <div className="absolute top-[55%] left-[41%] transform -translate-x-1/2 -translate-y-1/2 z-20 pulse-animation flex flex-col items-center">
                                    <div className="bg-red-600 text-white text-xs font-bold px-2 py-1 rounded mb-1 shadow">1차 장애물</div>
                                    <img src={IMAGES.warning} alt="1차 위험" className="w-12 h-12 drop-shadow-xl" />
                                </div>
                            )}

                            {/* 2차 장애물 팝업 */}
                            {phase === 'OBS_2' && (
                                <div className="absolute top-[40%] left-[38%] transform -translate-x-1/2 -translate-y-1/2 z-20 pulse-animation flex flex-col items-center">
                                    <div className="bg-red-600 text-white text-xs font-bold px-2 py-1 rounded mb-1 shadow">2차 장애물 (도로정비)</div>
                                    <img src={IMAGES.warning} alt="2차 위험" className="w-12 h-12 drop-shadow-xl" />
                                </div>
                            )}

                            {/* 사용자 위치 화살표 마커 */}
                            {phase !== 'INIT' && phase !== 'DEST_CONFIRM' && phase !== 'DONE' && phase !== 'PARKING_SEARCH' && (
                                <img src={IMAGES.arrow} alt="사용자 위치" 
                                     className="absolute w-8 h-8 drop-shadow-lg z-30" 
                                     style={{ 
                                         top: `${arrow.top}%`, 
                                         left: `${arrow.left}%`, 
                                         transition: `left ${arrow.duration}s linear, top ${arrow.duration}s linear, transform 0.2s ease`,
                                         transform: `translate(-50%, -50%) rotate(${arrow.rotate}deg)` 
                                     }} 
                                />
                            )}

                            {/* 주차 안내 화면 UI */}
                            {phase === 'PARKING_SEARCH' && (
                                <div className="absolute top-[75%] left-[55%] transform -translate-x-1/2 -translate-y-1/2 z-40 bg-white/60 p-3 rounded-xl backdrop-blur-sm shadow-2xl flex gap-3">
                                    <div className="flex flex-col items-center group cursor-pointer hover:-translate-y-1 transition-transform">
                                        <div className="bg-white border border-gray-300 text-green-700 font-bold text-[11px] px-1 py-0.5 rounded shadow-sm mb-1 whitespace-nowrap">주차자리 있음</div>
                                        <div className="w-12 h-20 bg-blue-500 border-[4px] border-black shadow-inner flex items-center justify-center">
                                            <span className="text-white text-xs font-bold opacity-0 group-hover:opacity-100 bg-black/50 px-1 rounded">선택</span>
                                        </div>
                                    </div>
                                    <div className="flex flex-col items-center">
                                        <div className="bg-white border border-gray-300 text-red-600 font-bold text-[11px] px-1 py-0.5 rounded shadow-sm mb-1 whitespace-nowrap">1은 공사중</div>
                                        <div className="w-12 h-20 border-[4px] border-black parking-striped flex items-center justify-center">
                                            <div className="bg-white px-2 py-0.5 border-2 border-black text-black font-extrabold text-sm">1</div>
                                        </div>
                                    </div>
                                    <div className="flex flex-col items-center">
                                        <div className="bg-white border border-gray-300 text-red-600 font-bold text-[11px] px-1 py-0.5 rounded shadow-sm mb-1 whitespace-nowrap">2는 사용중</div>
                                        <div className="w-12 h-20 border-[4px] border-black parking-striped flex items-center justify-center">
                                            <div className="bg-white px-2 py-0.5 border-2 border-black text-black font-extrabold text-sm">2</div>
                                        </div>
                                    </div>
                                </div>
                            )}
                        </div>
                    </div>

                    <div className="w-1/4 min-w-[280px]">
                        {renderControlPanel()}
                    </div>
                </div>
            );
        };

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>
