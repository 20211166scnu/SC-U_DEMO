    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Kakao Maps JavaScript SDK: 카카오 개발자 콘솔에 등록한 Web 도메인을 사용하세요. -->
